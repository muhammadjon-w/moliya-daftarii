# Nusxa oling: .env.example -> .env.local (lokal) yoki .env.production (server uchun build)

# Backend API. Lokal ishlab chiqishda /api/v1 qoldiring (Vite proxy Django'ga yo'naltiradi).
VITE_API_BASE_URL=/api/v1

# Faqat lokal: Telegram'siz brauzerda ochish uchun test foydalanuvchi id'si.
# Backend .env ichida DEBUG=true va DEV_AUTH_ENABLED=true bo'lishi kerak. Production build'da e'tiborga olinmaydi.
VITE_DEV_USER_ID=1001

# Bot nomi, @ belgisisiz (to'lov sahifasidagi "Telegram orqali kirish" uchun)
VITE_BOT_USERNAME=

# To'lov sayti manzili (bo'sh bo'lsa joriy domen ishlatiladi)
VITE_SITE_URL=
